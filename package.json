{
  "name": "oculo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "corepack pnpm --filter @oculo/mobile dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "release:check": "node apps/mobile/scripts/check-release.mjs",
    "cap:sync": "corepack pnpm build && corepack pnpm --filter @oculo/mobile exec cap sync",
    "release:candidate": "node scripts/release-candidate.mjs",
    "model:cinematographer": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} -b -P tools/blender/cinematographer.py",
    "scenes:build": "node tools/scenes/build.mjs",
    "scenes:upload": "node tools/scenes/upload-hf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@huggingface/hub": "^2.17.5",
    "@playcanvas/splat-transform": "^3.6.6",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
