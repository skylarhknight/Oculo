# RevenueCat public SDK keys. Native purchases stay disabled when the matching key is empty.
# For the Test Store demo, copy this file to the git-ignored apps/mobile/.env.local and paste
# your Test Store key (it starts with test_) on the iOS line. Never commit a key.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
# Exact catalog mapping; it must match the RevenueCat dashboard, including capitalization.
# Missing or mismatched values disable new purchases.
VITE_REVENUECAT_OFFERING_ID=default
VITE_REVENUECAT_PRO_PACKAGE_ID=Oculo_Pro_Lifetime
VITE_REVENUECAT_IOS_PRO_PRODUCT_ID=oculo_pro_lifetime
VITE_REVENUECAT_ANDROID_PRO_PRODUCT_ID=
# Explicit local development demo only; never enables mock purchases in production.
VITE_REVENUECAT_MOCK=false

# Public HTTPS pages shown on the paywall. Required for paid purchase disclosures.
VITE_PRIVACY_POLICY_URL=https://github.com/skylarhknight/Oculo/blob/main/PRIVACY.md
VITE_TERMS_URL=https://github.com/skylarhknight/Oculo/blob/main/TERMS.md
VITE_SUPPORT_URL=https://github.com/skylarhknight/Oculo/issues

# Firebase web app configuration (public identifiers, not secrets).
# Accounts and cloud sync stay disabled when these are empty; the app remains fully local.
# Use your Firebase development project's values locally and your production project's for release builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Scene gallery: HTTPS folder holding the download scenes from `pnpm scenes:build`
# (dist-scenes/). The host must allow cross-origin GETs. Empty lists them as unavailable.
VITE_SCENE_GALLERY_BASE_URL=
